library(inverter_char_lib) {
  delay_model : table_lookup;
  in_place_val : 1.80;
  voltage_unit : "1V";
  time_unit : "1ns";
  leakage_power_unit : "1nW";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1,pf);

  lu_table_template(delay_template_5x5) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_cap;
    index_1 ("0.010000, 0.057500, 0.105000, 0.152500, 0.200000");
    index_2 ("0.005000, 0.016250, 0.027500, 0.038750, 0.050000");
  }

  cell(INV) {
    area : 10.0;
    
    pin(in) {
      direction : input;
      capacitance : 0.00854; /* 8.54 fF extracted input capacitance */
    }
    
    pin(out) {
      direction : output;
      function : "!in";
      
      timing() {
        related_pin : "in";
        timing_sense : negative_unate;
        
        cell_rise(delay_template_5x5) {
          values ( \
            "0.114488, 0.366112, 0.617768, 0.869429, 1.121088", \
            "0.128515, 0.380135, 0.631786, 0.883442, 1.135102", \
            "0.142771, 0.394382, 0.646032, 0.897688, 1.149349", \
            "0.156944, 0.408545, 0.660193, 0.911850, 1.163510", \
            "0.171076, 0.422665, 0.674310, 0.925967, 1.177626" \
          );
        }
        
        cell_fall(delay_template_5x5) {
          values ( \
            "0.058638, 0.184414, 0.310234, 0.436054, 0.561887", \
            "0.072597, 0.198397, 0.324204, 0.450037, 0.575862", \
            "0.086838, 0.212644, 0.338452, 0.464282, 0.590109", \
            "0.100994, 0.226805, 0.352614, 0.478441, 0.604269", \
            "0.115097, 0.240921, 0.366731, 0.492556, 0.618384" \
          );
        }
        
        rise_transition(delay_template_5x5) {
          values ( \
            "0.229449, 0.745334, 1.261263, 1.777246, 2.293204", \
            "0.229479, 0.745303, 1.261283, 1.777243, 2.293199", \
            "0.229481, 0.745311, 1.261280, 1.777244, 2.293196", \
            "0.230708, 0.745317, 1.261278, 1.777245, 2.293195", \
            "0.233474, 0.745321, 1.261275, 1.777246, 2.293197" \
          );
        }
        
        fall_transition(delay_template_5x5) {
          values ( \
            "0.114814, 0.372744, 0.630672, 0.888626, 1.146628", \
            "0.114866, 0.372706, 0.630688, 0.888641, 1.146610", \
            "0.117499, 0.372717, 0.630688, 0.888636, 1.146615", \
            "0.121851, 0.372725, 0.630687, 0.888631, 1.146618", \
            "0.128148, 0.372923, 0.630685, 0.888627, 1.146621" \
          );
        }
      }
    }
  }
}
